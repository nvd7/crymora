{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crymora",
  "version": "0.1.1",
  "identifier": "app.crymora.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crymora",
        "width": 1160,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://valorant-api.com; img-src 'self' data: https://media.valorant-api.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "languages": ["PortugueseBR"]
      }
    }
  }
}
